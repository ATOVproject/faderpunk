{
  "name": "configurator",
  "private": true,
  "version": "1.13.0-beta.2",
  "license": "GPL-3.0",
  "description": "Web configurator for Faderpunk",
  "packageManager": "pnpm@11.1.1",
  "scripts": {
    "dev": "vite",
    "dev:landing": "vite --config vite.landing.config.mjs",
    "dev:apps": "vite --config vite.apps.config.mjs",
    "build": "tsc -b tsconfig.app.json && vite build",
    "build:landing": "tsc -b tsconfig.landing.json && vite build --config vite.landing.config.mjs",
    "build:apps": "tsc -b tsconfig.apps.json && vite build --config vite.apps.config.mjs",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@heroui/button": "^2.2.32",
    "@heroui/checkbox": "^2.3.32",
    "@heroui/input": "^2.4.33",
    "@heroui/modal": "^2.2.29",
    "@heroui/number-input": "^2.0.23",
    "@heroui/select": "^2.4.33",
    "@heroui/skeleton": "^2.2.18",
    "@heroui/slider": "^2.4.29",
    "@heroui/switch": "^2.2.27",
    "@heroui/system": "^2.4.28",
    "@heroui/table": "^2.2.32",
    "@heroui/tabs": "^2.2.29",
    "@heroui/theme": "^2.4.26",
    "@heroui/toast": "^2.0.22",
    "@heroui/tooltip": "^2.2.29",
    "@types/w3c-web-usb": "^1.0.14",
    "classnames": "^2.5.1",
    "framer-motion": "^14.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "semver": "^7.8.5",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/semver": "^7.8.0",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^16.3.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.3.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@heroui/shared-utils",
      "@swc/core",
      "@tailwindcss/oxide",
      "esbuild"
    ]
  }
}